PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/deep-work.db
AUDIO_DIR=./assets/audio
CORS_ORIGIN=http://localhost:5173
# Proxy inverso (false | true | 1 | loopback | lista IP/CIDR separada por comas)
TRUST_PROXY=false

# Fase 7: Mini Buscador (opcional; Wikipedia y Stack Overflow funcionan sin API key)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
STACKEXCHANGE_API_KEY=
SEARCH_TIMEOUT_MS=8000

# Autenticación (Usuario/Contraseña + Google Sign-In + Guardar sesión)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SESSION_TTL_HOURS=24
AUTH_REMEMBER_ME_DAYS=30
